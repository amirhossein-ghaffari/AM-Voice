<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080B14"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AM VOICE"
            android:textColor="#F4F8FF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ENGLISH OFFLINE SPEECH ENGINE • DEBUG BUILD"
            android:textColor="#00D9FF"
            android:textSize="10sp"
            android:layout_marginTop="6dp" />

        <FrameLayout
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_panel">
            <TextView
                android:id="@+id/wakeOrb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="◉"
                android:textColor="#00D9FF"
                android:textSize="82sp" />
        </FrameLayout>
        <TextView
            android:id="@+id/wakeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="SAY “AM AM” TO WAKE"
            android:textColor="#AAB7CC"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/reviewButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="REVIEW INSTALLED APPS &amp; CONTACTS"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/bg_button"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:id="@+id/overlayButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="ENABLE OPTIONAL FLOATING WAKE EFFECT"
            android:textColor="#00D9FF"
            android:textStyle="bold"
            android:background="#142033"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:id="@+id/inventoryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="70dp"
            android:background="#111827"
            android:padding="12dp"
            android:text="Tap review to view apps and contacts allowed by Android."
            android:textColor="#B8C7DA"
            android:textSize="12sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Assistant ready — say AM AM"
            android:textColor="#F4F8FF"
            android:textSize="19sp"
            android:gravity="center"
            android:layout_marginTop="22dp" />
        <TextView
            android:id="@+id/heardText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Press start, then say: AM AM"
            android:textColor="#AAB7CC"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:minHeight="48dp" />

        <TextView
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center"
            android:text="START LISTENING"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button"
            android:layout_marginTop="20dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TEST SEQUENCE\n1. Say: AM AM\n2. Wait for the green pulsing orb\n3. Say: Open Chrome or Call Dad\n\nCall commands: Call Dad • Call to Dad • Phone Dad • Dial Dad\nOther commands: Open Camera • Open Camera • Open WhatsApp • Open Telegram • Open YouTube • Open Instagram • Open Gmail • Open Maps • Open Spotify • Open Calculator • Open app [name] • Open Settings • Flashlight on/off • Volume up/down • What time is it • Stop listening"
            android:textColor="#D7E0EF"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="22dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LIVE DIAGNOSTICS"
            android:textColor="#00D9FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />
        <TextView
            android:id="@+id/debugText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="150dp"
            android:background="#111827"
            android:padding="12dp"
            android:text="Waiting for diagnostic events..."
            android:textColor="#B8C7DA"
            android:textSize="11sp"
            android:typeface="monospace"
            android:textIsSelectable="true"
            android:lineSpacingExtra="3dp"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
